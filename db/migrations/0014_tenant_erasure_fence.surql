DEFINE TABLE tenant_erasure_fence SCHEMAFULL;
DEFINE FIELD tenant_id ON TABLE tenant_erasure_fence TYPE string;
DEFINE FIELD request_id ON TABLE tenant_erasure_fence TYPE string;
DEFINE FIELD state ON TABLE tenant_erasure_fence TYPE string ASSERT $value IN ['erasing', 'erased'];
DEFINE FIELD created_at ON TABLE tenant_erasure_fence TYPE datetime;
DEFINE FIELD updated_at ON TABLE tenant_erasure_fence TYPE datetime;
DEFINE INDEX tenant_erasure_fence_tenant_unique ON TABLE tenant_erasure_fence FIELDS tenant_id UNIQUE;
DEFINE INDEX tenant_erasure_fence_request_unique ON TABLE tenant_erasure_fence FIELDS request_id UNIQUE;

DEFINE FUNCTION fn::assert_tenant_writable($tenant_id: string) {
    LET $fences = SELECT VALUE id FROM tenant_erasure_fence WHERE tenant_id = $tenant_id LIMIT 1;
    IF array::len($fences) > 0 { THROW 'tenant writes are fenced'; };
    RETURN true;
};

DEFINE EVENT tenant_erasure_write_fence ON TABLE trace_run WHEN $event = 'CREATE' OR $event = 'UPDATE' THEN fn::assert_tenant_writable($after.tenant_id);
DEFINE EVENT tenant_erasure_write_fence ON TABLE canonical_event WHEN $event = 'CREATE' OR $event = 'UPDATE' THEN fn::assert_tenant_writable($after.tenant_id);
DEFINE EVENT tenant_erasure_write_fence ON TABLE ingest_receipt WHEN $event = 'CREATE' OR $event = 'UPDATE' THEN fn::assert_tenant_writable($after.tenant_id);
