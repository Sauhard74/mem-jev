-- Immutable planner configuration. Activation is a tenant-scoped pointer update.
DEFINE TABLE IF NOT EXISTS planner_manifest SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS tenant_id ON TABLE planner_manifest TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS planner_manifest_id ON TABLE planner_manifest TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS version ON TABLE planner_manifest TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS compatibility_matrix ON TABLE planner_manifest TYPE object FLEXIBLE READONLY;
DEFINE FIELD IF NOT EXISTS limits ON TABLE planner_manifest TYPE object FLEXIBLE READONLY;
DEFINE FIELD IF NOT EXISTS coefficients ON TABLE planner_manifest TYPE object FLEXIBLE READONLY;
DEFINE FIELD IF NOT EXISTS canonical_manifest ON TABLE planner_manifest TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS created_at ON TABLE planner_manifest TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE planner_manifest TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE planner_manifest TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE INDEX IF NOT EXISTS planner_manifest_tenant_id_unique ON TABLE planner_manifest FIELDS tenant_id, planner_manifest_id UNIQUE;

DEFINE TABLE IF NOT EXISTS planner_serving_head SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS tenant_id ON TABLE planner_serving_head TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS planner_manifest_id ON TABLE planner_serving_head TYPE string;
DEFINE FIELD IF NOT EXISTS updated_at ON TABLE planner_serving_head TYPE datetime;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE planner_serving_head TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE planner_serving_head TYPE string ASSERT string::len($value) = 64;
DEFINE INDEX IF NOT EXISTS planner_serving_head_tenant_unique ON TABLE planner_serving_head FIELDS tenant_id UNIQUE;

-- Epoch-pinned typed compatibility. Text and embedding similarity never create these edges.
DEFINE TABLE IF NOT EXISTS procedure_compatibility_edge SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS tenant_id ON TABLE procedure_compatibility_edge TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS compatibility_edge_id ON TABLE procedure_compatibility_edge TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS projection_epoch ON TABLE procedure_compatibility_edge TYPE int READONLY ASSERT $value > 0;
DEFINE FIELD IF NOT EXISTS source_procedure_version_id ON TABLE procedure_compatibility_edge TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS target_procedure_version_id ON TABLE procedure_compatibility_edge TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS source_interface_hash ON TABLE procedure_compatibility_edge TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE FIELD IF NOT EXISTS target_interface_hash ON TABLE procedure_compatibility_edge TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE FIELD IF NOT EXISTS source_provision_ids ON TABLE procedure_compatibility_edge TYPE array<string> READONLY;
DEFINE FIELD IF NOT EXISTS satisfied_requirement_ids ON TABLE procedure_compatibility_edge TYPE array<string> READONLY;
DEFINE FIELD IF NOT EXISTS planner_manifest_id ON TABLE procedure_compatibility_edge TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS policy_manifest_id ON TABLE procedure_compatibility_edge TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS canonical_edge ON TABLE procedure_compatibility_edge TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS created_at ON TABLE procedure_compatibility_edge TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE procedure_compatibility_edge TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE procedure_compatibility_edge TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE INDEX IF NOT EXISTS procedure_compatibility_edge_tenant_epoch_unique ON TABLE procedure_compatibility_edge FIELDS tenant_id, projection_epoch, compatibility_edge_id UNIQUE;
DEFINE INDEX IF NOT EXISTS procedure_compatibility_edge_source ON TABLE procedure_compatibility_edge FIELDS tenant_id, projection_epoch, source_procedure_version_id;
DEFINE INDEX IF NOT EXISTS procedure_compatibility_edge_target ON TABLE procedure_compatibility_edge FIELDS tenant_id, projection_epoch, target_procedure_version_id;

-- A complete selection is committed before its injection_id can be returned to an agent.
-- The record and child rows are immutable and expire under tenant retention policy.
DEFINE TABLE IF NOT EXISTS selection_record SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS tenant_id ON TABLE selection_record TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS injection_id ON TABLE selection_record TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS idempotency_identity_hash ON TABLE selection_record TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE FIELD IF NOT EXISTS query_hash ON TABLE selection_record TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE FIELD IF NOT EXISTS request_context_hash ON TABLE selection_record TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE FIELD IF NOT EXISTS retrieval_run_id ON TABLE selection_record TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS projection_epoch ON TABLE selection_record TYPE int READONLY ASSERT $value > 0;
DEFINE FIELD IF NOT EXISTS document_set_hash ON TABLE selection_record TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE FIELD IF NOT EXISTS serving_config_id ON TABLE selection_record TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS policy_manifest_id ON TABLE selection_record TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS ranker_manifest_id ON TABLE selection_record TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS planner_manifest_id ON TABLE selection_record TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS lifecycle_policy_manifest_id ON TABLE selection_record TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS experiment_manifest_id ON TABLE selection_record TYPE option<string> READONLY;
DEFINE FIELD IF NOT EXISTS experiment_assignment_id ON TABLE selection_record TYPE option<string> READONLY;
DEFINE FIELD IF NOT EXISTS novelty_class ON TABLE selection_record TYPE string READONLY ASSERT $value IN ["exact", "known_shape", "bridged", "partial", "unseen"];
DEFINE FIELD IF NOT EXISTS plan_hash ON TABLE selection_record TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE FIELD IF NOT EXISTS canonical_selection ON TABLE selection_record TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS created_at ON TABLE selection_record TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS expires_at ON TABLE selection_record TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE selection_record TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE selection_record TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE INDEX IF NOT EXISTS selection_record_tenant_injection_unique ON TABLE selection_record FIELDS tenant_id, injection_id UNIQUE;
DEFINE INDEX IF NOT EXISTS selection_record_tenant_idempotency_unique ON TABLE selection_record FIELDS tenant_id, idempotency_identity_hash UNIQUE;
DEFINE INDEX IF NOT EXISTS selection_record_retrieval_run ON TABLE selection_record FIELDS tenant_id, retrieval_run_id UNIQUE;
DEFINE INDEX IF NOT EXISTS selection_record_expiry ON TABLE selection_record FIELDS expires_at;

DEFINE TABLE IF NOT EXISTS selection_plan_node SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS tenant_id ON TABLE selection_plan_node TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS injection_id ON TABLE selection_plan_node TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS ordinal ON TABLE selection_plan_node TYPE int READONLY ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS procedure_version_id ON TABLE selection_plan_node TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS interface_hash ON TABLE selection_plan_node TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE FIELD IF NOT EXISTS role ON TABLE selection_plan_node TYPE string READONLY ASSERT $value IN ["primary", "bridge"];
DEFINE FIELD IF NOT EXISTS parallel_group_id ON TABLE selection_plan_node TYPE option<string> READONLY;
DEFINE FIELD IF NOT EXISTS created_at ON TABLE selection_plan_node TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS expires_at ON TABLE selection_plan_node TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE selection_plan_node TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE selection_plan_node TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE INDEX IF NOT EXISTS selection_plan_node_tenant_ordinal_unique ON TABLE selection_plan_node FIELDS tenant_id, injection_id, ordinal UNIQUE;
DEFINE INDEX IF NOT EXISTS selection_plan_node_version ON TABLE selection_plan_node FIELDS tenant_id, procedure_version_id, created_at;
DEFINE INDEX IF NOT EXISTS selection_plan_node_expiry ON TABLE selection_plan_node FIELDS expires_at;

DEFINE TABLE IF NOT EXISTS selection_plan_edge SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS tenant_id ON TABLE selection_plan_edge TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS injection_id ON TABLE selection_plan_edge TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS plan_edge_id ON TABLE selection_plan_edge TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS source_ordinal ON TABLE selection_plan_edge TYPE int READONLY ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS target_ordinal ON TABLE selection_plan_edge TYPE int READONLY ASSERT $value >= 0 AND $value != source_ordinal;
DEFINE FIELD IF NOT EXISTS compatibility_edge_id ON TABLE selection_plan_edge TYPE option<string> READONLY;
DEFINE FIELD IF NOT EXISTS source_provision_ids ON TABLE selection_plan_edge TYPE array<string> READONLY;
DEFINE FIELD IF NOT EXISTS satisfied_requirement_ids ON TABLE selection_plan_edge TYPE array<string> READONLY;
DEFINE FIELD IF NOT EXISTS created_at ON TABLE selection_plan_edge TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS expires_at ON TABLE selection_plan_edge TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE selection_plan_edge TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE selection_plan_edge TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE INDEX IF NOT EXISTS selection_plan_edge_tenant_id_unique ON TABLE selection_plan_edge FIELDS tenant_id, injection_id, plan_edge_id UNIQUE;
DEFINE INDEX IF NOT EXISTS selection_plan_edge_expiry ON TABLE selection_plan_edge FIELDS expires_at;

DEFINE TABLE IF NOT EXISTS selection_plan_gap SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS tenant_id ON TABLE selection_plan_gap TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS injection_id ON TABLE selection_plan_gap TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS ordinal ON TABLE selection_plan_gap TYPE int READONLY ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS code ON TABLE selection_plan_gap TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS requirement_id ON TABLE selection_plan_gap TYPE option<string> READONLY;
DEFINE FIELD IF NOT EXISTS created_at ON TABLE selection_plan_gap TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS expires_at ON TABLE selection_plan_gap TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE selection_plan_gap TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE selection_plan_gap TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE INDEX IF NOT EXISTS selection_plan_gap_tenant_ordinal_unique ON TABLE selection_plan_gap FIELDS tenant_id, injection_id, ordinal UNIQUE;
DEFINE INDEX IF NOT EXISTS selection_plan_gap_expiry ON TABLE selection_plan_gap FIELDS expires_at;

-- Lifecycle policy and evidence are append-only. Heads are derived projections, not evidence.
DEFINE TABLE IF NOT EXISTS lifecycle_policy_manifest SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS tenant_id ON TABLE lifecycle_policy_manifest TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS lifecycle_policy_manifest_id ON TABLE lifecycle_policy_manifest TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS version ON TABLE lifecycle_policy_manifest TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS thresholds ON TABLE lifecycle_policy_manifest TYPE object FLEXIBLE READONLY;
DEFINE FIELD IF NOT EXISTS canonical_manifest ON TABLE lifecycle_policy_manifest TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS created_at ON TABLE lifecycle_policy_manifest TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE lifecycle_policy_manifest TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE lifecycle_policy_manifest TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE INDEX IF NOT EXISTS lifecycle_policy_manifest_tenant_id_unique ON TABLE lifecycle_policy_manifest FIELDS tenant_id, lifecycle_policy_manifest_id UNIQUE;

DEFINE TABLE IF NOT EXISTS lifecycle_decision SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS tenant_id ON TABLE lifecycle_decision TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS lifecycle_decision_id ON TABLE lifecycle_decision TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS procedure_id ON TABLE lifecycle_decision TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS procedure_version_id ON TABLE lifecycle_decision TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS lifecycle_policy_manifest_id ON TABLE lifecycle_decision TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS prior_state ON TABLE lifecycle_decision TYPE string READONLY ASSERT $value IN ["candidate", "trial", "active", "retired", "quarantined"];
DEFINE FIELD IF NOT EXISTS next_state ON TABLE lifecycle_decision TYPE string READONLY ASSERT $value IN ["candidate", "trial", "active", "retired", "quarantined"];
DEFINE FIELD IF NOT EXISTS causal_success_count ON TABLE lifecycle_decision TYPE int READONLY ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS causal_failure_count ON TABLE lifecycle_decision TYPE int READONLY ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS associated_success_count ON TABLE lifecycle_decision TYPE int READONLY ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS associated_failure_count ON TABLE lifecycle_decision TYPE int READONLY ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS unsafe_outcome_count ON TABLE lifecycle_decision TYPE int READONLY ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS wilson_lower_bound_ppm ON TABLE lifecycle_decision TYPE int READONLY ASSERT $value >= 0 AND $value <= 1000000;
DEFINE FIELD IF NOT EXISTS reason_codes ON TABLE lifecycle_decision TYPE array<string> READONLY;
DEFINE FIELD IF NOT EXISTS evidence_cutoff_at ON TABLE lifecycle_decision TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS canonical_decision ON TABLE lifecycle_decision TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS created_at ON TABLE lifecycle_decision TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE lifecycle_decision TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE lifecycle_decision TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE INDEX IF NOT EXISTS lifecycle_decision_tenant_id_unique ON TABLE lifecycle_decision FIELDS tenant_id, lifecycle_decision_id UNIQUE;
DEFINE INDEX IF NOT EXISTS lifecycle_decision_version_time ON TABLE lifecycle_decision FIELDS tenant_id, procedure_version_id, created_at;
DEFINE INDEX IF NOT EXISTS lifecycle_decision_family_time ON TABLE lifecycle_decision FIELDS tenant_id, procedure_id, created_at;

DEFINE TABLE IF NOT EXISTS experiment_manifest SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS tenant_id ON TABLE experiment_manifest TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS experiment_manifest_id ON TABLE experiment_manifest TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS procedure_id ON TABLE experiment_manifest TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS champion_version_id ON TABLE experiment_manifest TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS challenger_version_ids ON TABLE experiment_manifest TYPE array<string> READONLY;
DEFINE FIELD IF NOT EXISTS experiment_epoch ON TABLE experiment_manifest TYPE int READONLY ASSERT $value > 0;
DEFINE FIELD IF NOT EXISTS exposure_limits ON TABLE experiment_manifest TYPE object FLEXIBLE READONLY;
DEFINE FIELD IF NOT EXISTS risk_policy ON TABLE experiment_manifest TYPE object FLEXIBLE READONLY;
DEFINE FIELD IF NOT EXISTS canonical_manifest ON TABLE experiment_manifest TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS created_at ON TABLE experiment_manifest TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE experiment_manifest TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE experiment_manifest TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE INDEX IF NOT EXISTS experiment_manifest_tenant_id_unique ON TABLE experiment_manifest FIELDS tenant_id, experiment_manifest_id UNIQUE;
DEFINE INDEX IF NOT EXISTS experiment_manifest_family_epoch_unique ON TABLE experiment_manifest FIELDS tenant_id, procedure_id, experiment_epoch UNIQUE;

DEFINE TABLE IF NOT EXISTS experiment_assignment SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS tenant_id ON TABLE experiment_assignment TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS experiment_assignment_id ON TABLE experiment_assignment TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS experiment_manifest_id ON TABLE experiment_assignment TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS assignment_key_hash ON TABLE experiment_assignment TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE FIELD IF NOT EXISTS assigned_procedure_version_id ON TABLE experiment_assignment TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS bucket ON TABLE experiment_assignment TYPE int READONLY ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS canonical_assignment ON TABLE experiment_assignment TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS created_at ON TABLE experiment_assignment TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS expires_at ON TABLE experiment_assignment TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE experiment_assignment TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE experiment_assignment TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE INDEX IF NOT EXISTS experiment_assignment_tenant_id_unique ON TABLE experiment_assignment FIELDS tenant_id, experiment_assignment_id UNIQUE;
DEFINE INDEX IF NOT EXISTS experiment_assignment_key_unique ON TABLE experiment_assignment FIELDS tenant_id, experiment_manifest_id, assignment_key_hash UNIQUE;
DEFINE INDEX IF NOT EXISTS experiment_assignment_expiry ON TABLE experiment_assignment FIELDS expires_at;

-- Mutable materialized counters are reconstructable from immutable assignments and selections.
DEFINE TABLE IF NOT EXISTS experiment_exposure_counter SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS tenant_id ON TABLE experiment_exposure_counter TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS experiment_manifest_id ON TABLE experiment_exposure_counter TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS procedure_version_id ON TABLE experiment_exposure_counter TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS window_start ON TABLE experiment_exposure_counter TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS exposure_count ON TABLE experiment_exposure_counter TYPE int ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS unsafe_count ON TABLE experiment_exposure_counter TYPE int ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS updated_at ON TABLE experiment_exposure_counter TYPE datetime;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE experiment_exposure_counter TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE experiment_exposure_counter TYPE string ASSERT string::len($value) = 64;
DEFINE INDEX IF NOT EXISTS experiment_exposure_counter_tenant_window_unique ON TABLE experiment_exposure_counter FIELDS tenant_id, experiment_manifest_id, procedure_version_id, window_start UNIQUE;

-- Outcome credit is immutable but transient; promotion evaluations retain the exact durable aggregate.
DEFINE TABLE IF NOT EXISTS outcome_credit SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS tenant_id ON TABLE outcome_credit TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS outcome_credit_id ON TABLE outcome_credit TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS outcome_id ON TABLE outcome_credit TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS injection_id ON TABLE outcome_credit TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS task_execution_id ON TABLE outcome_credit TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS procedure_version_id ON TABLE outcome_credit TYPE option<string> READONLY;
DEFINE FIELD IF NOT EXISTS credit_class ON TABLE outcome_credit TYPE string READONLY ASSERT $value IN ["causal_success", "associated_success", "causal_failure", "associated_failure", "unattributable"];
DEFINE FIELD IF NOT EXISTS rule_manifest_id ON TABLE outcome_credit TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS reason_codes ON TABLE outcome_credit TYPE array<string> READONLY;
DEFINE FIELD IF NOT EXISTS canonical_credit ON TABLE outcome_credit TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS created_at ON TABLE outcome_credit TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS expires_at ON TABLE outcome_credit TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE outcome_credit TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE outcome_credit TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE INDEX IF NOT EXISTS outcome_credit_tenant_id_unique ON TABLE outcome_credit FIELDS tenant_id, outcome_credit_id UNIQUE;
DEFINE INDEX IF NOT EXISTS outcome_credit_outcome_unique ON TABLE outcome_credit FIELDS tenant_id, outcome_id UNIQUE;
DEFINE INDEX IF NOT EXISTS outcome_credit_injection ON TABLE outcome_credit FIELDS tenant_id, injection_id, created_at;
DEFINE INDEX IF NOT EXISTS outcome_credit_expiry ON TABLE outcome_credit FIELDS expires_at;

DEFINE TABLE IF NOT EXISTS promotion_evaluation SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS tenant_id ON TABLE promotion_evaluation TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS promotion_evaluation_id ON TABLE promotion_evaluation TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS procedure_id ON TABLE promotion_evaluation TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS procedure_version_id ON TABLE promotion_evaluation TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS lifecycle_policy_manifest_id ON TABLE promotion_evaluation TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS causal_success_count ON TABLE promotion_evaluation TYPE int READONLY ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS causal_failure_count ON TABLE promotion_evaluation TYPE int READONLY ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS associated_success_count ON TABLE promotion_evaluation TYPE int READONLY ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS associated_failure_count ON TABLE promotion_evaluation TYPE int READONLY ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS unsafe_outcome_count ON TABLE promotion_evaluation TYPE int READONLY ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS wilson_lower_bound_ppm ON TABLE promotion_evaluation TYPE int READONLY ASSERT $value >= 0 AND $value <= 1000000;
DEFINE FIELD IF NOT EXISTS recommendation ON TABLE promotion_evaluation TYPE string READONLY ASSERT $value IN ["hold", "trial", "activate", "retire", "quarantine", "rollback"];
DEFINE FIELD IF NOT EXISTS reason_codes ON TABLE promotion_evaluation TYPE array<string> READONLY;
DEFINE FIELD IF NOT EXISTS evidence_cutoff_at ON TABLE promotion_evaluation TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS canonical_evaluation ON TABLE promotion_evaluation TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS created_at ON TABLE promotion_evaluation TYPE datetime READONLY;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE promotion_evaluation TYPE string READONLY;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE promotion_evaluation TYPE string READONLY ASSERT string::len($value) = 64;
DEFINE INDEX IF NOT EXISTS promotion_evaluation_tenant_id_unique ON TABLE promotion_evaluation FIELDS tenant_id, promotion_evaluation_id UNIQUE;
DEFINE INDEX IF NOT EXISTS promotion_evaluation_version_time ON TABLE promotion_evaluation FIELDS tenant_id, procedure_version_id, created_at;
